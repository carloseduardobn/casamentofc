# String de conexão do banco Postgres (Vercel Postgres, Neon, Supabase, Railway, etc.)
# Exemplo Vercel Postgres: postgres://usuario:senha@host:5432/banco?sslmode=require
DATABASE_URL=

# Senha do administrador (texto simples). Troque por algo forte.
ADMIN_PASSWORD=troque-esta-senha

# Segredo usado para assinar o cookie de sessão do admin. Gere uma string aleatória longa.
# Você pode gerar uma com: openssl rand -hex 32
SESSION_SECRET=troque-este-segredo-tambem
